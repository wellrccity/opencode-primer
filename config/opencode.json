{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": 12000
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/logs/**",
      "**/*.log",
      "**/dist/**",
      "**/build/**",
      "**/__pycache__/**",
      "**/.venv/**"
    ]
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": "sudo rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "sudo rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item -Recurse -Force C:\\", "effect": "deny" },
    { "action": "shell", "resource": "mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git push * --force*", "effect": "ask" },
    { "action": "shell", "resource": "git push -f*", "effect": "ask" },
    { "action": "shell", "resource": "git push * -f*", "effect": "ask" }
  ]
}
